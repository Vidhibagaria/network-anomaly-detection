# AI Network Anomaly Detection - Configuration
# Copy this to .env and customize

# Application
APP_NAME="AI Network Anomaly Detection System"
APP_VERSION="1.0.0"
DEBUG=false
SECRET_KEY="change-me-in-production-use-a-long-random-string"

# Paths (relative to project root, or absolute)
# DATA_DIR=./data
# MODELS_DIR=./trained_models
# UPLOADS_DIR=./uploads

# Dataset
LABEL_COLUMN=Label
RANDOM_SEED=42
TEST_SIZE=0.2

# File upload limits
MAX_FILE_SIZE_MB=500

# Random Forest defaults
RF_N_ESTIMATORS=100
RF_MAX_DEPTH=
RF_MIN_SAMPLES_SPLIT=2
RF_MIN_SAMPLES_LEAF=1
RF_MAX_FEATURES=sqrt
RF_CLASS_WEIGHT=balanced

# LSTM defaults
LSTM_SEQUENCE_LENGTH=10
LSTM_UNITS=64
LSTM_DROPOUT=0.2
LSTM_EPOCHS=20
LSTM_BATCH_SIZE=256
LSTM_MAX_SAMPLES=200000

# Autoencoder defaults
AE_EPOCHS=30
AE_BATCH_SIZE=256
AE_THRESHOLD_PERCENTILE=95.0
AE_MAX_SAMPLES=200000

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
